# Both of these are optional. With neither set, Zetdle runs exactly as it
# always has - the game is identical, there is just no sign-in button.
#
# Find them in the Supabase dashboard under Project Settings -> API.
# Copy this file to .env.local (which git ignores) and fill them in.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
